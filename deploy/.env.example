# Generate deploy/.env with scripts/rshwub-init-env.py; never commit real values.
# Both image references must include @sha256:<64 hex characters>.
RSHWUB_MEET_IMAGE=
POSTGRES_IMAGE=
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
SECRET_PASSWORD=GENERATE_SESSION_SECRET
MAINTENANCE_BYPASS_TOKEN=GENERATE_MAINTENANCE_TOKEN
MAINTENANCE_MODE=false

# Resend sending key, restricted to the verified sending domain where supported.
SMTP_PWD=
# Set a real monitored mailbox and a sender on your verified Resend domain.
SUPPORT_EMAIL=
NOREPLY_EMAIL=

# No KV_REST_API_* variables: one web replica uses upstream's memory limiter.
# No S3_* variables: uploads are optional and disabled until configured.
# Leave NEXT_PUBLIC_COOKIE_DOMAIN unset to isolate cookies to meet.rshwub.com.
