# Install as /etc/rshwub-meet/backup.env, owned by root with mode 0600.
# Find the actual db volume in Openship service details / docker inspect.
BACKUP_DB_VOLUME=
BACKUP_DB_USER=rallly
BACKUP_DB_NAME=rallly
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=rshwub-meet/postgres
# R2: https://<account-id>.r2.cloudflarestorage.com; never use plain HTTP.
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Public age recipient only. Keep its private identity OFF the VPS.
AGE_RECIPIENT=
